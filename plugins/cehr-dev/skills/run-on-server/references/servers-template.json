{
  "read_names": [
    "*.log",
    "trainer_state.json",
    "metrics.json",
    "*_metrics.json",
    "all_results.json",
    "train_results.json",
    "eval_results.json"
  ],
  "servers": {
    "<ssh alias>": {
      "repos": {
        "<repository name>": {
          "path": "/absolute/path/to/the/repository",
          "setup": "source .venv/bin/activate",
          "run": [
            "python -m <package>.",
            "python -u -m <package>.",
            "bash scripts/"
          ]
        }
      },
      "log_dir": "/absolute/path/where/job/logs/go",
      "read_roots": [
        "/absolute/path/where/job/logs/go",
        "/absolute/path/to/experiment/outputs"
      ],
      "deny_parts": [
        "dataset_prepared",
        "patient_sequence"
      ],
      "env": [
        "CUDA_VISIBLE_DEVICES",
        "HF_HOME",
        "PYTHONPATH"
      ]
    }
  }
}
